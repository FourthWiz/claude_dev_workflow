{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist-test",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "paths": {
      "vscode": ["./src/test/__mocks__/vscode"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/types.ts",
    "src/sessionManager.ts",
    "src/scriptRootCheck.ts",
    "src/test/**/*.ts"
  ]
}
